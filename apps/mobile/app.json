{
  "expo": {
    "name": "ملامح",
    "slug": "malamih",
    "scheme": "malamih",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "ps.malamih.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to sort nearby medical and cosmetic clinics and show them on the map.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-router", "expo-location", "expo-notifications"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
