{
  "expo": {
    "name": "Palestine Dental Directory",
    "slug": "palestine-dental-directory",
    "scheme": "palestinedentaldirectory",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لترتيب أطباء الأسنان حسب الأقرب لك وعرضهم على الخريطة."
      }
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": ["expo-router", "expo-location"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
