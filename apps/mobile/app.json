{
  "expo": {
    "name": "ملامح",
    "slug": "malamih",
    "scheme": "malamih",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "ps.malamih.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to sort nearby medical and cosmetic clinics and show them on the map.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "package": "ps.malamih.app"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0afe92b7-860e-493a-977e-b2742b96b947"
      }
    },
    "owner": "ashtayeh"
  }
}
