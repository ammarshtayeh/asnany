{
  "name": "@pal-dental/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go -c",
    "start:go:8083": "expo start --go -c --port 8083",
    "start:offline": "expo start --offline -c",
    "start:lan": "expo start --lan -c",
    "start:tunnel": "expo start --tunnel -c",
    "start:dev-client": "expo start --dev-client -c",
    "start:dev-client:lan": "expo start --dev-client --lan -c",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel -c",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082",
    "build:apk": "eas build --profile preview --platform android",
    "build:apk:prod": "eas build --profile production-apk --platform android",
    "build:android:store": "eas build --profile production --platform android",
    "build:ios:store": "eas build --profile production --platform ios",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pal-dental/shared": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
