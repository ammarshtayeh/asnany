{
  "name": "palestine-dental-directory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @pal-dental/web run dev",
    "dev:mobile": "npm --workspace @pal-dental/mobile run start",
    "dev:mobile:go": "npm --workspace @pal-dental/mobile run start:go",
    "dev:mobile:go:8083": "npm --workspace @pal-dental/mobile run start:go:8083",
    "dev:mobile:offline": "npm --workspace @pal-dental/mobile run start:offline",
    "dev:mobile:lan": "npm --workspace @pal-dental/mobile run start:lan",
    "dev:mobile:dev-client": "npm --workspace @pal-dental/mobile run start:dev-client",
    "lint:web": "npm --workspace @pal-dental/web run lint",
    "typecheck:web": "npm --workspace @pal-dental/web run typecheck",
    "supabase:link": "npx supabase link",
    "supabase:db:push": "npx supabase db push"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-screens": "4.16.0"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-screens": "4.16.0"
  }
}
